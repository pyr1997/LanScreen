# Generic Linux / NAS deployment parameters. Copy this file to .env locally.
# Host networking: this port must be unused on the deployment host.
LANSCREEN_PORT=18765
# Container RAM limit; this is not a media-storage quota.
LANSCREEN_MEMORY_LIMIT=5g
LANSCREEN_CPU_LIMIT=2.0
LANSCREEN_TZ=Asia/Shanghai
# Administrator and playback credentials are created by the application.
# Do not put production passwords, device tokens or signing secrets in this file.
